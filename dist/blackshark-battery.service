[Unit]
Description=Razer BlackShark V2 HyperSpeed battery level in tray
Documentation=https://github.com/TheRolfFR/blackshark-battery-tray
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/blackshark-battery run
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
